# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones hold the AI key and never get committed.
# `.env.example` is the contract the README tells people to copy, so it is
# re-included: `.env*` alone silently ignored it and left a fresh clone with no
# template to work from.
.env*
!.env.example

# Any SQLite database left over from before the PostgreSQL migration. It holds
# a real business, so a `git add .` must not be able to commit it.
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma client is generated from the schema — never committed
/src/generated
