# ---------------------------------------------------------------------------
# LUMEN — environment contract
# Copy to `.env` and fill in. Every key here is validated at boot by
# src/lib/env.ts; a missing or malformed value fails the process immediately.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------

# PostgreSQL connection string. Required — there is no sensible default for a
# database that lives on someone else's server.
#
# Free, no card, either is enough for a beta:
#   Supabase  https://supabase.com   500 MB, and the same project provides Auth
#   Neon      https://neon.com       0.5 GB, resumes on its own after idling
DATABASE_URL="postgresql://user:password@host:5432/database"

# debug | info | warn | error
LOG_LEVEL="debug"

# Public application URL. Must be HTTPS for preview/production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set true only when the reverse proxy strips incoming client-supplied forwarding headers
# and writes the real client address to X-Real-IP or the first X-Forwarded-For hop.
# Required outside local development because auth abuse protection depends on it.
TRUST_PROXY_HEADERS="false"

# local | preview | production
#
# Which deployment this process is. This is the ONE variable production-safety
# checks look at, and it must be set as a plain environment variable on the
# actual running container or process — not baked into a build.
#
# Do NOT confuse this with a `NEXT_PUBLIC_*` variable. Next.js inlines every
# `NEXT_PUBLIC_*` value into the compiled output at `npm run build` time; a
# platform that builds once and only sets environment variables when the
# container starts (Docker, most PaaS deploys) would silently keep whichever
# value was present at build time forever, no matter what is configured at
# runtime afterward. `APP_ENV` has no `NEXT_PUBLIC_` prefix specifically so
# that cannot happen: set it wherever you set DATABASE_URL, and it takes effect
# the moment the process starts.
APP_ENV="local"

# --- Identity ---------------------------------------------------------------

# local | supabase
#
# `local` is a test double: accounts live in the server process's memory and
# vanish when it stops. It exists so the suites can drive real signup and login
# without a network call or a mailbox. The process REFUSES TO START with
# AUTH_PROVIDER="local" outside APP_ENV="local".
#
# `supabase` is the real one. Set the two keys below with it.
AUTH_PROVIDER="local"

# From the Supabase dashboard: Project Settings → API.
#
# The anon key is public by design — it goes to the browser, and what it may do
# is governed by Supabase's own rules rather than by secrecy. The `service_role`
# key is the opposite: it bypasses every rule, Lumen never uses it, and it must
# not appear in this file or any other.
#
# Add ${NEXT_PUBLIC_APP_URL}/auth/confirm under Authentication → URL
# Configuration → Redirect URLs, or the link in the confirmation email quietly
# falls back to the project's site URL.
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# --- Beta ---------------------------------------------------------------------

# Comma-separated addresses. Empty (the default) means nobody — set this
# before the first real signup, or there is no way to become the first
# founder and issue the first invite. Whoever may issue invites can also
# disable any other account, so treat this list the way you would treat a
# list of who has the database password.
FOUNDER_EMAILS="you@yourcompany.com"

# Shown in the app as where to write when something is broken. Not a secret —
# it is configuration because it changes per deployment.
SUPPORT_EMAIL="support@yourcompany.com"

# invite | open
#
# invite (the default) means nobody may sign up without being listed in
# FOUNDER_EMAILS above or holding an unused invite issued from /admin by
# someone who is. Set to "open" for a public launch — anyone may then create
# an account with no invite. Founders, /admin, and disabling an account still
# work identically either way; this only changes who may sign up.
BETA_SIGNUP="invite"

# --- Billing (Paddle) -------------------------------------------------------
# Leave all of this unset to run without checkout. Everything else works; the
# Plan panel says checkout is not configured, and nothing can be bought.

# From Paddle → Developer tools → Notifications, on the endpoint you point at
# ${NEXT_PUBLIC_APP_URL}/api/webhooks/paddle. Starts with `pdl_ntfset_`.
#
# This is the ONE that matters. It is what proves a webhook came from Paddle,
# and a webhook is the only thing that grants a paid subscription. Without it
# every event is refused — deliberately, because accepting unverified events
# "until billing is set up" is how a stranger gets a free subscription.
# PADDLE_NOTIFICATION_SECRET="pdl_ntfset_..."

# The recurring Price you created for the plan. Starts with `pri_`.
# PADDLE_PRICE_ID="pri_..."

# sandbox | production. Keep it on sandbox until you have taken a real payment
# in sandbox and watched the webhook arrive.
PADDLE_ENVIRONMENT="sandbox"

# Optional server-side Paddle API key. Used only to create short-lived customer
# portal links for payment-method updates and subscription management. Keep it
# server-only, grant only the Customer Portal session permission, and rotate it.
# PADDLE_API_KEY="pdl_sdbx_apikey_..."
# PADDLE_API_TIMEOUT_MS="5000"

# --- Email (Resend) ---------------------------------------------------------
# `log` sends nothing and records that a message would have gone. That is the
# default, and it is what development and the test suites use.

# log | resend
EMAIL_PROVIDER="log"

# From resend.com/api-keys. Server-only: it never reaches the browser, and it
# is never written to the email log.
# RESEND_API_KEY="re_..."

# The verified sending address. Resend refuses anything from a domain you have
# not verified with its DNS records, so this must match one you have.
# EMAIL_FROM="Lumen <hello@yourdomain.com>"

# --- Client (inlined into the browser bundle — never put secrets here) -------
# NEXT_PUBLIC_APP_URL is set once, in the Server section above.

# Paddle's client-side token, from Paddle → Developer tools → Authentication.
# Public by design: it names the seller so the checkout overlay knows whose it
# is, and grants nothing. Starts with `test_` in sandbox, `live_` in production.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# --- AI ---------------------------------------------------------------------
# All AI calls are made server-side. Never expose a key through NEXT_PUBLIC_*.

# mock | anthropic. `mock` needs no key and is what the test suite uses.
AI_PROVIDER="mock"

# Required only when AI_PROVIDER="anthropic".
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional; the anthropic provider defaults to claude-sonnet-5. Leave unset
# for the other providers, which each pick their own default (see below) —
# a set AI_MODEL applies to whichever provider is active.
# AI_MODEL="claude-sonnet-5"

# Per-attempt timeout, not a budget for the whole run.
AI_TIMEOUT_MS="30000"

# Bounded exponential backoff between attempts.
AI_MAX_ATTEMPTS="3"
AI_RETRY_BASE_MS="400"
AI_RETRY_MAX_MS="8000"

# --- Free provider options -------------------------------------------------
# All three work without a credit card. Pick one and set AI_PROVIDER to match.
#
# Google Gemini — the widest free daily allowance. Get a key at
# https://aistudio.google.com/apikey
# Note: on Google's free tier your prompts may be used to improve their
# products. Use the paid tier if that matters for your business data.
# AI_PROVIDER="gemini"
# GOOGLE_API_KEY="..."
#
# Groq — much faster responses, smaller daily allowance. Key at
# https://console.groq.com/keys
# AI_PROVIDER="groq"
# GROQ_API_KEY="gsk_..."
#
# OpenRouter — one key reaches hundreds of models from dozens of vendors,
# instead of committing to one. Get a key at https://openrouter.ai/keys.
# Unlike the others, AI_MODEL here is not optional pinning, it IS the model
# choice — the default below is a free one with its own small daily/per-minute
# limit; set AI_MODEL to any paid model on the same key to lift that.
# AI_PROVIDER="openrouter"
# OPENROUTER_API_KEY="sk-or-v1-..."
#
# Optional: pin a specific model. Each provider has a sensible default, so
# leave this unset unless you have a reason.
# AI_MODEL="gemini-2.5-flash"         # gemini
# AI_MODEL="openai/gpt-oss-120b"      # groq
# AI_MODEL="openai/gpt-oss-120b:free" # openrouter
